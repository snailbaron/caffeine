load("@bazel_skylib//lib:paths.bzl", "paths")
load("//bzl:aseprite.bzl", "ase_export")

[
    ase_export(
        name = "export_" + paths.split_extension(paths.basename(p))[0],
        src = p,
        frame_range = [
            0,
            0,
        ],
    )
    for p in glob(["*.aseprite"])
]
